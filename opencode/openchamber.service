[Unit]
Description=OpenChamber webserver
After=network-online.target

[Service]
Type=simple

Environment="PATH=%h/.local/share/mise/shims:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin"
Environment=BASH_ENV=%h/dotfiles/bash/bashenv
EnvironmentFile=-%h/.config/openchamber/startup.env
ExecStart=/usr/bin/bun %h/.bun/bin/openchamber serve --foreground --port 3000 --host 0.0.0.0 --api-only

Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=default.target
