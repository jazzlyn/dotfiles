{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "~/.secrets/**", "effect": "ask" },
    {
      "action": "read",
      "resource": "*external-secret.yaml",
      "effect": "allow"
    },
    { "action": "read", "resource": "*secret.yaml", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "~/.secrets/**", "effect": "ask" },
    {
      "action": "edit",
      "resource": "*external-secret.yaml",
      "effect": "allow"
    },
    { "action": "edit", "resource": "*secret.yaml", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*.secrets*", "effect": "ask" },
    {
      "action": "shell",
      "resource": "*external-secret.yaml*",
      "effect": "allow"
    },
    { "action": "shell", "resource": "*secret.yaml*", "effect": "allow" },
    { "action": "shell", "resource": "curl *-T*", "effect": "ask" },
    { "action": "shell", "resource": "rtk curl *-T*", "effect": "ask" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "rtk git push*", "effect": "ask" },
    { "action": "shell", "resource": "git * push*", "effect": "ask" },
    { "action": "shell", "resource": "rtk git * push*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr create*", "effect": "ask" },
    { "action": "shell", "resource": "rtk gh pr create*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "ask" },
    { "action": "shell", "resource": "rtk gh pr merge*", "effect": "ask" },
    {
      "action": "shell",
      "resource": "gh pr review*--comment*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rtk gh pr review*--comment*",
      "effect": "ask"
    },
    { "action": "shell", "resource": "gh pr review*-c*", "effect": "ask" },
    { "action": "shell", "resource": "rtk gh pr review*-c*", "effect": "ask" },
    {
      "action": "external_directory",
      "resource": "/home/opencode/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/srv/shared/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "todowrite", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "atlassian_*", "resource": "*", "effect": "ask" },
    {
      "action": "atlassian_atlassianUserInfo",
      "resource": "*",
      "effect": "allow"
    },
    { "action": "atlassian_fetch", "resource": "*", "effect": "allow" },
    { "action": "atlassian_get*", "resource": "*", "effect": "allow" },
    { "action": "atlassian_lookup*", "resource": "*", "effect": "allow" },
    { "action": "atlassian_search*", "resource": "*", "effect": "allow" },
    { "action": "github_*", "resource": "*", "effect": "ask" },
    { "action": "github_get*", "resource": "*", "effect": "allow" },
    { "action": "github_issue_read", "resource": "*", "effect": "allow" },
    { "action": "github_list*", "resource": "*", "effect": "allow" },
    {
      "action": "github_pull_request_read",
      "resource": "*",
      "effect": "allow"
    },
    { "action": "github_search*", "resource": "*", "effect": "allow" },
    { "action": "github_create_repository", "resource": "*", "effect": "deny" },
    { "action": "github_delete_file", "resource": "*", "effect": "deny" },
    { "action": "github_delete_repository", "resource": "*", "effect": "deny" },
    { "action": "github_fork_repository", "resource": "*", "effect": "deny" },
    {
      "action": "github_run_secret_scanning",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "agents": {
    "build": { "disabled": false },
    "general": { "disabled": true },
    "explore": { "disabled": true },
    "plan": { "color": "#FFFF00" },
    "title": {
      "model": { "providerID": "github-copilot", "model": "gpt-5.6-luna" }
    }
  },
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp"
      },
      "home-assistant": {
        "type": "remote",
        "url": "https://hass.techtales.io/api/mcp",
        "oauth": {
          "client_id": "http://localhost:19876",
          "redirect_uri": "http://localhost:19876/mcp/oauth/callback"
        }
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}"
        }
      }
    }
  },
  "plugins": ["oh-my-opencode-slim@3.0.2"],
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "github-models",
        "effect": "deny"
      },
      { "action": "provider.use", "resource": "opencode", "effect": "deny" }
    ]
  }
}
