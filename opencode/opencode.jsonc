{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": true,
  "disabled_providers": ["github-models", "opencode"],
  "small_model": "github-copilot/gpt-5.6-luna",
  "agent": {
    "build": {
      "disable": false
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "plan": {
      "color": "#FFFF00"
    },
    // Workaround: oh-my-opencode-slim's applyDefaultPermissions() sets
    // agent.config.permission on the orchestrator agent (to grant task_*/
    // question/skill tools) but never merges in the top-level `permission`
    // block below. Since opencode agent-level permission fully REPLACES
    // top-level permission (not merges), the orchestrator ends up with only
    // those few keys and silently loses every other rule (github_*, bash
    // git-push guard, atlassian_*, secret file ask, etc.). Mirror the
    // top-level permission block here so the orchestrator keeps the same
    // enforcement. Keep this in sync with the top-level "permission" object.
    "orchestrator": {
      "permission": {
        "read": {
          "*": "allow",
          "~/.secrets/**": "ask",
          "*external-secret.yaml": "allow",
          "*secret.yaml": "allow"
        },
        "edit": {
          "*": "allow",
          "~/.secrets/**": "ask",
          "*external-secret.yaml": "allow",
          "*secret.yaml": "allow"
        },
        "bash": {
          "*": "allow",
          "*.secrets*": "ask",
          "*external-secret.yaml*": "allow",
          "*secret.yaml*": "allow",
          "curl *-T*": "ask",
          "rtk curl *-T*": "ask",
          "git push*": "ask",
          "rtk git push*": "ask",
          "git * push*": "ask",
          "rtk git * push*": "ask",
          "gh pr create*": "ask",
          "rtk gh pr create*": "ask",
          "gh pr merge*": "ask",
          "rtk gh pr merge*": "ask"
        },
        "external_directory": {
          "/home/opencode/**": "allow",
          "/srv/shared/**": "allow",
          "/tmp/**": "allow"
        },
        "doom_loop": "ask",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "question": "allow",
        "skill": "allow",
        "task": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "atlassian_*": "ask",
        "atlassian_atlassianUserInfo": "allow",
        "atlassian_fetch": "allow",
        "atlassian_get*": "allow",
        "atlassian_lookup*": "allow",
        "atlassian_search*": "allow",
        "github_*": "ask",
        "github_get*": "allow",
        "github_issue_read": "allow",
        "github_list*": "allow",
        "github_pull_request_read": "allow",
        "github_search*": "allow"
      }
    }
  },
  "mcp": {
    "atlassian": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "home-assistant": {
      "enabled": true,
      "type": "remote",
      "url": "https://hass.techtales.io/api/mcp",
      "oauth": {
        "clientId": "http://localhost:19876",
        "redirectUri": "http://localhost:19876/mcp/oauth/callback"
      }
    },
    "github": {
      "enabled": true,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    }
  },
  "plugin": [
    [
      "@devtheops/opencode-plugin-otel",
      {
        "enabled": true,
        "endpoint": "http://127.0.0.1:4317",
        "resource_attributes": "service.name=oc-jazzlyn"
      }
    ],
    "oh-my-opencode-slim"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "~/.secrets/**": "ask",
      "*external-secret.yaml": "allow",
      "*secret.yaml": "allow"
    },
    "edit": {
      "*": "allow",
      "~/.secrets/**": "ask",
      "*external-secret.yaml": "allow",
      "*secret.yaml": "allow"
    },
    "bash": {
      "*": "allow",
      "*.secrets*": "ask",
      "*external-secret.yaml*": "allow",
      "*secret.yaml*": "allow",
      "curl *-T*": "ask",
      "rtk curl *-T*": "ask",
      "git push*": "ask",
      "rtk git push*": "ask",
      "git * push*": "ask",
      "rtk git * push*": "ask",
      "gh pr create*": "ask",
      "rtk gh pr create*": "ask",
      "gh pr merge*": "ask",
      "rtk gh pr merge*": "ask"
    },
    "external_directory": {
      "/home/opencode/**": "allow",
      "/srv/shared/**": "allow",
      "/tmp/**": "allow"
    },
    "doom_loop": "ask",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "question": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "atlassian_*": "ask",
    "atlassian_atlassianUserInfo": "allow",
    "atlassian_fetch": "allow",
    "atlassian_get*": "allow",
    "atlassian_lookup*": "allow",
    "atlassian_search*": "allow",
    "github_*": "ask",
    "github_get*": "allow",
    "github_issue_read": "allow",
    "github_list*": "allow",
    "github_pull_request_read": "allow",
    "github_search*": "allow"
  }
  // "provider": {
  //   "github-copilot": {
  //     "whitelist": []
  //   },
  //   "opencode-go": {
  //     "whitelist": []
  //   }
  // },
}
